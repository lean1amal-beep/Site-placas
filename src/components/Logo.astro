---
// Logo: a placa em L vista de lado, com um G branco simples no meio (versão B, escolhida pelo Leandro em 17/10).
interface Props {
  tamanho?: number;
}
const { tamanho = 26 } = Astro.props;
---

<svg class="logo" width={tamanho} height={tamanho} viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round" stroke-linecap="round" aria-hidden="true">
  <path d="M9.5 3.5 L23.5 5.2 L22.2 25.2 L8.2 25.9 Z"></path>
  <path d="M8.2 25.9 L22.2 25.2 L26 27.6 L12.2 28.4 Z"></path>
  <path d="M19.2 12 A4.6 4.6 0 1 0 20.5 15.2 H16.4" transform="rotate(4 15.9 15)"></path>
</svg>
